# Copy this file to .env and fill in your own values. .env is git-ignored.

# Required: TMDB API v4 read access token (https://www.themoviedb.org/settings/api)
TMDB_READ_TOKEN=your_tmdb_v4_read_access_token_here

# Optional: port (default 3000)
# PORT=3000

# Optional: "Sledovat společně" guest server (only room pages) — default PORT + 1, 0 = off.
# This is the only port to expose to the internet (e.g. sudo tailscale funnel --bg 3001).
# GUEST_PORT=3001
# Its public address, used in the room links you share. Not needed with Tailscale Funnel —
# FilmBox finds the Funnel address by itself. Without either, links work only at home / in Tailscale.
# PUBLIC_URL=https://your-pi.your-tailnet.ts.net

# Optional: online Czech/Slovak subtitles from OpenSubtitles.com
# (Profile → API consumers). Without a key the feature stays hidden.
# OPENSUBTITLES_API_KEY=your_api_key
# Optional login for a higher daily download quota:
# OPENSUBTITLES_USERNAME=your_username
# OPENSUBTITLES_PASSWORD=your_password

# ── Optional ──
# Chytré "Co dnes?" (AI picks with Claude) — https://console.anthropic.com; without it the box is hidden
# ANTHROPIC_API_KEY=sk-ant-...
# Automatic intro / credits detection needs ffmpeg (sudo apt install ffmpeg); 0 = off
# FILMBOX_AUTO_INTRO=0
# Where "Stáhnout do FilmBoxu" keeps videos (default data/downloads) and the free space it leaves
# FILMBOX_DOWNLOAD_DIR=/mnt/usb/filmbox
# FILMBOX_DOWNLOAD_MIN_FREE_GB=2
# New-episode notifications (ntfy)
# NTFY_SERVER=https://ntfy.sh
# FILMBOX_URL=https://your-filmbox-address
# FILMBOX_NOTIFY=0
# Hide "Aktualizovat a restartovat" on the Server page
# FILMBOX_ALLOW_UPDATE=0
