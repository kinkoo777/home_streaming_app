# Copy this file to .env and fill in your own values. .env is git-ignored.

# Required: TMDB API v4 read access token (https://www.themoviedb.org/settings/api)
TMDB_READ_TOKEN=your_tmdb_v4_read_access_token_here

# Optional: port (default 3000)
# PORT=3000

# Optional: online Czech/Slovak subtitles from OpenSubtitles.com
# (Profile → API consumers). Without a key the feature stays hidden.
# OPENSUBTITLES_API_KEY=your_api_key
# Optional login for a higher daily download quota:
# OPENSUBTITLES_USERNAME=your_username
# OPENSUBTITLES_PASSWORD=your_password
