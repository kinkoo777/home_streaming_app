# Copy this file to .env and fill in your own values. .env is git-ignored.

# Required: TMDB API v4 read access token (https://www.themoviedb.org/settings/api) — film titles and posters
TMDB_READ_TOKEN=your_tmdb_v4_read_access_token_here

# The public address of Kouknem, used in room links and in the policy (no trailing slash)
PUBLIC_URL=https://kouknem.cz

# Optional: port (default 3000)
# PORT=3000

# Behind a reverse proxy (Caddy, nginx, Cloudflare Tunnel…) on the same machine the default
# "loopback" is right. Otherwise set the proxy's address, e.g. 10.0.0.2, or a hop count, e.g. 1.
# TRUST_PROXY=loopback

# Optional: how many rooms may be open at once (default 200). Each playing room can
# pull video through this server when a viewer's browser can't play it directly.
# KOUKNEM_MAX_ROOMS=200
# Optional: new rooms one IP address may open per 10 minutes (default 5)
# KOUKNEM_ROOMS_PER_IP=5

# Optional: where notices, the blocklist and the TMDB cache are stored (default ./data)
# KOUKNEM_DATA_DIR=/var/lib/kouknem

# Operator details shown in the Copyright, Notice-and-Action & Intermediary Services Policy
# and in the footer. Until set, the pages show "[to be completed: …]".
KOUKNEM_OPERATOR=Your Company s.r.o.
KOUKNEM_ADDRESS=Street 1, 110 00 Praha 1, Czech Republic
KOUKNEM_COMPANY_ID=IČO 12345678
KOUKNEM_COPYRIGHT_EMAIL=copyright@kouknem.cz
KOUKNEM_POLICY_DATE=1 November 2026
